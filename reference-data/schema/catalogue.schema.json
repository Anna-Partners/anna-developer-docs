{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anna.partners/schemas/developer-reference/catalogue-1.json",
  "title": "Anna Developer Reference catalogue (reference.json)",
  "description": "Render contract for the /developers/reference catalogue. Versioned: bump `version` major for breaking shape changes — Nexus rejects unknown majors at load time.",
  "type": "object",
  "required": ["version", "groups_order", "sections"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "groups_order": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "section": {
      "type": "object",
      "required": ["group", "id", "kicker", "title", "sub"],
      "properties": {
        "group": { "type": "string" },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kicker": { "type": "string" },
        "title": { "type": "string" },
        "sub": { "type": "string" },
        "source": { "enum": ["host_api", "events", "app_manifest", "platform_tools"] },
        "detail_source": { "type": "string", "pattern": "\\.json$" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "items"],
            "properties": {
              "label": { "type": "string" },
              "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
            },
            "additionalProperties": false
          }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["name", "desc"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "desc": { "type": "string" },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "type": "string" },
              "kind": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
